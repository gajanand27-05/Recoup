# Copy to .env and fill in. .env is gitignored and must never be committed.

# Razorpay TEST mode only. Dashboard -> Settings -> API Keys -> Generate Test Key.
RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set this yourself when creating the webhook in the Razorpay dashboard.
# The same value must appear in both places or signature verification fails.
RZP_WEBHOOK_SECRET=choose-any-string-and-paste-it-in-the-dashboard-too

# The LLM. Set the key matching RECOUP_LLM_MODEL; the others may stay blank.
# The model id is recorded on every classification, and a reported figure may
# never pool results from two different models -- two models are two instruments.
#
# gpt-oss:120b via Ollama Cloud is the default because the alternatives could not
# be called enough times: the Gemini free tier allows 20 requests per DAY
# (INC-008), which cannot complete even the 60-fixture accuracy eval.
#
# Note A-024: Ollama accepts a JSON schema and IGNORES it, returning HTTP 200
# either way. The schema is therefore spelled into the prompt and the output is
# validated by Pydantic at the boundary. Requested, not enforced.
OLLAMA_API_KEY=your-key-from-ollama.com
OLLAMA_HOST=https://ollama.com
GEMINI_API_KEY=your-key-from-aistudio.google.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
RECOUP_LLM_MODEL=gpt-oss:120b

# Changing this reshuffles arm assignment. Do not change mid-experiment.
EXPERIMENT_SALT=recoup-2026-08

RECOUP_DB=runs/recoup.db
