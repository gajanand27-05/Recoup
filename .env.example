# Copy to .env and fill in. .env is gitignored and must never be committed.

# Razorpay TEST mode only. Dashboard -> Settings -> API Keys -> Generate Test Key.
RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set this yourself when creating the webhook in the Razorpay dashboard.
# The same value must appear in both places or signature verification fails.
RZP_WEBHOOK_SECRET=choose-any-string-and-paste-it-in-the-dashboard-too

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Changing this reshuffles arm assignment. Do not change mid-experiment.
EXPERIMENT_SALT=recoup-2026-08

RECOUP_DB=runs/recoup.db
